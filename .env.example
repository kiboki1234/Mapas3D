# Copie este archivo como .env. Todas las rutas pueden cambiarse sin editar código.
CITY3D_ENVIRONMENT=development
CITY3D_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CITY3D_MAX_RADIUS_M=1000
CITY3D_DEFAULT_FLOOR_HEIGHT_M=3.0
CITY3D_UNKNOWN_BUILDING_HEIGHT_M=6.0
CITY3D_HTTP_TIMEOUT_SECONDS=45
CITY3D_USER_AGENT=City3D-Engine/0.1 (contacto-del-operador)
CITY3D_OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
CITY3D_OSM_MAP_ENDPOINT=https://api.openstreetmap.org/api/0.6/map.json

# Integración opcional futura con OSM2World.
CITY3D_OSM2WORLD_HOME=

